  // PATCH /{{resource}}/{id}
  update: (id: string, body: Partial<Create{{Resource}}Input>) =>
    http.patch<{{Resource}}>(`/{{resource}}/${id}`, body).then(r => r.data),

  // DELETE /{{resource}}/{id}
  remove: (id: string) =>
